{
  "name": "tempoll",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm prisma:generate && pnpm build",
    "verify:ci": "pnpm verify && docker build -t tempoll-debug .",
    "security:scan-secrets": "node scripts/secret-scan.mjs",
    "security:audit": "pnpm audit --prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prisma": "^7.10.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "postcss": "8.5.26",
      "svix": "1.92.2",
      "@hono/node-server": "1.19.15",
      "defu": "6.1.7",
      "effect": "3.21.0",
      "deepmerge-ts": "8.0.2",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "lodash": "4.18.1",
