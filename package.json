{
  "name": "tempoll",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm prisma:generate && pnpm build",
    "verify:ci": "pnpm verify && docker build -t tempoll-debug .",
    "security:scan-secrets": "node scripts/secret-scan.mjs",
    "security:audit": "pnpm audit --prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "resend": "^6.17.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prisma": "^7.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "postcss": "8.5.10",
      "svix": "1.92.2",
      "@hono/node-server": "1.19.14",
      "defu": "6.1.7",
      "effect": "3.21.0",
      "fast-uri": "3.1.2",
      "hono": "4.12.30",
      "lodash": "4.18.1",
      "minimatch@3>brace-expansion": "1.1.13",
      "minimatch@10>brace-expansion": "5.0.6"
