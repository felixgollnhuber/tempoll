diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..a5fddcd832b19a2b1667c820bec92e66260bead7
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,22 @@
+'use strict';
+
+const { MAX_DEPTH } = require('./constants');
+
+module.exports = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop();
+    if (depth > MAX_DEPTH) {
+      throw new RangeError(`Pattern nesting depth exceeds maximum of ${MAX_DEPTH}`);
+    }
+
+    if (node && node.nodes) {
+      for (const child of node.nodes) {
+        if (child && child.nodes) {
+          stack.push({ node: child, depth: depth + 1 });
+        }
+      }
+    }
+  }
+};
